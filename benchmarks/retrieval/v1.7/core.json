{
  "schemaVersion": "1.0.0",
  "suiteId": "retrieval-regression-core-v1.7",
  "name": "Retrieval regression core suite",
  "description": "Representative deterministic retrieval regression suite for my-dev-kit's v1.6.0 context-capsule workflow.",
  "target": "my-dev-kit",
  "defaultMode": "general",
  "tasks": [
    {
      "id": "data-model-user-feature-add",
      "title": "Data model User feature-add retrieval",
      "description": "Validates that context execution can generate a capsule and retrieval audit record for a small data-model fixture, and that the generated evidence satisfies stable retrieval-quality expectations.",
      "fixtureRoot": "../../../examples/basic-data-model-ts",
      "sourceRoots": ["src"],
      "query": "add a sibling data model field to User",
      "mode": "feature-add",
      "noSource": false,
      "skip": false,
      "tags": ["data-model", "context", "feature-add"],
      "caps": { "maxCandidateFiles": 20, "maxSourceSlices": 8, "maxGraphNodes": 20, "maxGraphEdges": 20 },
      "expectations": {
        "candidateFiles": [
          { "pathContains": "models.ts", "topK": 3, "required": true }
        ],
        "candidateNodes": [
          { "nodeIdContains": "User", "pathContains": "models.ts", "topK": 8, "required": true }
        ],
        "focus": {
          "pathContains": "models.ts",
          "nodeIdContains": "User",
          "allowNoFocus": false,
          "required": true
        },
        "selectedGraph": {
          "requiredFileContains": ["models.ts"],
          "maxNodes": 20,
          "maxEdges": 20,
          "required": true
        },
        "sourceEvidence": {
          "requiredFileContains": ["models.ts"],
          "minSlices": 1,
          "maxSlices": 8,
          "required": true
        },
        "semanticSummary": {
          "required": true,
          "requiredRoles": ["data-entity"],
          "allowUnavailable": false
        },
        "classificationSummary": {
          "required": true,
          "requiredCategories": ["canonical-type"],
          "requiredEditGuidance": ["inspect-before-edit"],
          "allowUnavailable": false
        },
        "artifactReferences": {
          "requiredKinds": ["symbolIndex", "codeGraph"],
          "allowUnavailable": false,
          "required": true
        },
        "conflicts": {
          "expectedStatus": "none",
          "allowNone": true,
          "required": true
        },
        "auditSteps": {
          "requiredStepIds": [
            "step-validate-inputs",
            "step-load-manifest",
            "step-run-search",
            "step-select-primary-focus",
            "step-write-context-capsule",
            "step-write-retrieval-audit-record"
          ],
          "requireUniqueStepIds": true,
          "minStepCount": 20,
          "required": true
        },
        "noRawContent": {
          "enabled": true
        },
        "caps": {
          "maxCandidateFiles": 20,
          "maxCandidateNodes": 20,
          "maxSourceSlices": 8,
          "maxGraphNodes": 20,
          "maxGraphEdges": 20
        },
        "adequacy": {
          "allowedStatuses": [
            "context sufficient for implementation",
            "context sufficient with listed assumptions"
          ],
          "allowAssumptions": true,
          "allowConflict": false,
          "allowInsufficient": false,
          "required": true
        }
      }
    },
    {
