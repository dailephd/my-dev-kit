{
  "name": "@dailephd/my-dev-kit",
  "version": "1.14.0",
  "description": "Local codebase graph indexing, semantic enrichment, bounded source retrieval, React/TSX frontend indexing, data-model extraction, conservative static lineage, and conservative static Android project/component detection for TypeScript, JavaScript, Python, Kotlin, and Java projects.",
  "type": "module",
  "bin": {
    "my-dev-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/CI_CD.md",
    "docs/COMMANDS.md",
    "docs/DEVELOPMENT.md",
    "docs/ECOSYSTEM_COORDINATED_ROADMAP.md",
    "docs/ECOSYSTEM_DEVELOPMENT_WORKFLOWS.md",
    "docs/GRAPH_SCHEMA.md",
    "docs/PROJECT_OVERVIEW.md",
    "docs/QUICKSTART.md",
    "docs/RELEASE.md",
    "docs/ROADMAP.md",
    "docs/SECURITY.md",
    "docs/WORKFLOWS.md",
    "examples/README.md",
    "examples/basic-data-model-ts/src",
    "examples/basic-data-model-ts/README.md",
    "examples/basic-ts/src",
    "examples/basic-ts/README.md",
    "examples/basic-python/src",
    "examples/basic-python/README.md",
    "examples/basic-react-tsx/src",
    "examples/basic-react-tsx/README.md",
    "examples/basic-android-kotlin/README.md",
    "examples/basic-android-kotlin/settings.gradle.kts",
    "examples/basic-android-kotlin/build.gradle.kts",
    "examples/basic-android-kotlin/app/build.gradle.kts",
    "examples/basic-android-kotlin/app/src",
    "examples/basic-rust-workspace/README.md",
    "examples/basic-rust-workspace/Cargo.toml",
    "examples/basic-rust-workspace/crates/core/Cargo.toml",
    "examples/basic-rust-workspace/crates/core/src/lib.rs",
    "examples/basic-rust-workspace/crates/core/src/tasks.rs",
    "examples/basic-rust-workspace/crates/core/tests/worker_tests.rs",
    "examples/basic-rust-workspace/crates/cli/Cargo.toml",
    "examples/basic-rust-workspace/crates/cli/src/main.rs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "docs:check": "tsx scripts/docs/checkDocs.ts",
    "verify": "npm run typecheck && npm run build && npm run docs:check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build -- --silent",
    "benchmark:retrieval": "tsx src/retrievalRegression/runRetrievalRegression.ts --config benchmarks/retrieval/v1.7/core.json --out .my-dev-kit/retrieval-regression --fail-on-regression",
    "benchmark:retrieval:android": "tsx src/retrievalRegression/runRetrievalRegression.ts --config benchmarks/retrieval/v1.13/android.json --out .my-dev-kit/retrieval-regression-android --fail-on-regression"
  },
  "license": "MIT",
  "author": "dailephd LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dailephd/my-dev-kit.git"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "smol-toml": "1.9.1",
    "typescript": "^5.9.3",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
