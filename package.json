{
  "name": "@dailephd/my-dev-kit",
  "version": "1.9.0",
  "description": "Local codebase graph indexing, semantic enrichment, bounded source retrieval, React/TSX frontend indexing, data-model extraction, conservative static lineage, and conservative static Android project/component detection for TypeScript, JavaScript, Python, Kotlin, and Java projects.",
  "type": "module",
  "bin": {
    "my-dev-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/CI_CD.md",
    "docs/COMMANDS.md",
    "docs/DEVELOPMENT.md",
    "docs/GRAPH_SCHEMA.md",
    "docs/PROJECT_OVERVIEW.md",
    "docs/QUICKSTART.md",
    "docs/RELEASE.md",
    "docs/ROADMAP.md",
    "docs/SECURITY.md",
    "docs/WORKFLOWS.md",
    "examples/README.md",
    "examples/basic-data-model-ts/src",
    "examples/basic-data-model-ts/README.md",
    "examples/basic-ts/src",
    "examples/basic-ts/README.md",
    "examples/basic-python/src",
    "examples/basic-python/README.md",
    "examples/basic-react-tsx/src",
    "examples/basic-react-tsx/README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "docs:check": "tsx scripts/docs/checkDocs.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run docs:check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "benchmark:retrieval": "tsx src/retrievalRegression/runRetrievalRegression.ts --config benchmarks/retrieval/v1.7/core.json --out .my-dev-kit/retrieval-regression --fail-on-regression"
  },
  "license": "MIT",
  "author": "dailephd LLC",
  "dependencies": {
    "commander": "^12.1.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
